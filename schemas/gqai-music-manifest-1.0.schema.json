{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gqai.local/schemas/gqai-music-manifest-1.0.json",
  "title": "GQAI music manifest 1.0",
  "type": "object",
  "required": ["schema", "project_id", "source", "music", "mix", "output"],
  "properties": {
    "schema": {"const": "gqai-music-manifest-1.0"},
    "project_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "source": {"$ref": "#/$defs/asset"},
    "music": {"$ref": "#/$defs/asset"},
    "sound_effects": {"type": "array"},
    "output": {"$ref": "#/$defs/asset"},
    "mix": {"type": "object"}
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
